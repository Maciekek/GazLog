# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, type: Web application)
# Authorized redirect URI must be: <BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of the app (used for OAuth redirect URI and Secure cookies when https).
# Locally leave as is; in production e.g. https://gazlog.example.com
BASE_URL=http://localhost:3001

# Optional: comma-separated list of Google account e-mails allowed to log in. Empty = anyone.
ALLOWED_EMAILS=

# Comma-separated Google e-mails that get the admin role (user list at /admin). Default: maciekek@gmail.com
ADMIN_EMAILS=maciekek@gmail.com

# Optional: shown on the privacy page as the contact address (baked into the client at build time).
VITE_CONTACT_EMAIL=
