# ---- deploy/.env : copy to deploy/.env and fill in ----

# Your domain, DNS A/AAAA record must point at this server. Caddy gets a Let's Encrypt cert automatically.
DOMAIN=gazlog.pl
# E-mail for Let's Encrypt expiry notices (optional but recommended)
ACME_EMAIL=you@example.com

# Google OAuth (redirect URI in Google Cloud must be https://<DOMAIN>/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: only these Google accounts may sign in (comma-separated). Empty = anyone.
ALLOWED_EMAILS=

# Optional: image tag to run (latest, a git sha, or a version like 1.0.0)
GAZLOG_TAG=latest
